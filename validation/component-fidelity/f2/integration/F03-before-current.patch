@@ -0,0 +1,60 @@
+import type { Question } from '../contracts/question.ts';
+import { record as practicalRecord } from '../activities/igcse/energetics-practical/provider.ts';
+import { record as energyRecord } from '../activities/igcse/energy-enthalpy/provider.ts';
+import { bondingRecord } from '../activities/alevel/electrons-bonding/provider.ts';
+import { acidSourceQuestion, acidNotation } from '../activities/alevel/acid-base-calculations/provider.ts';
+import { calorimetrySource } from '../activities/igcse/calorimetry/provider.ts';
+import { bondSource } from '../activities/igcse/bond-enthalpy/provider.ts';
+import type { CalculationBlock } from '../chemistry/thermochemistry/types.ts';
+
+/** Activity metadata selects presentation; question identities never select a component. */
+export const sourceFamilies: Readonly<Record<string, string>> = {
+  'alevel/acid-base-calculations': 'acid',
+  'alevel/electrons-bonding': 'bonding',
+  'alevel/electron-configurations': 'electron',
+  'alevel/ph-titration-curves': 'titration',
+  'igcse/calorimetry': 'calorimetry',
+  'igcse/bond-enthalpy': 'bond',
+  'igcse/energy-enthalpy': 'energy',
+  'igcse/energetics-practical': 'practical',
+  'igcse/structure-and-bonding': 'comparison',
+};
+export interface SourceField { label: string; model?: string; feedback?: string; symbol?: string; multiline?: boolean; count?: number }
+export interface SourcePresentation {
+  family: string;
+  fields: Readonly<Record<string, SourceField>>;
+  practical?: ReturnType<typeof practicalRecord>;
+  calculations?: readonly (readonly CalculationBlock[])[];
+  feedback?: string;
+}
+export function sourcePresentation(question: Question): SourcePresentation {
+  const family = sourceFamilies[question.ref.activityId] ?? 'generic';
+  const fields: Record<string, SourceField> = {};
+  const base = { family, fields };
+  if (family === 'practical') {
+    const practical = practicalRecord(question.ref.questionId);
+    for (const field of practical.fields) fields[field.id] = { label: field.label, model: field.model, ...(field.feedback ? {feedback:field.feedback} : {}), multiline: !!(field as typeof field & {multiline?:boolean}).multiline, count: field.multiselect ? field.selectCount ?? field.answers.length : 1 };
+    if (practical.correction && practical.fields[0]) fields.correction = fields[practical.fields[0].id]!;
+    return {...base, practical};
+  }
+  if (family === 'acid') {
+    const source = acidSourceQuestion(question.ref);
+    for (const field of source.responses) fields[field.key] = { label: acidNotation(field.prompt), symbol: acidNotation(field.symbol) };
+  }
+  if (family === 'calorimetry' || family === 'bond') {
+    const source = family === 'calorimetry' ? calorimetrySource(question.ref.questionId) : bondSource(question.ref.questionId);
+    for (const [i, field] of source.responses.entries()) fields[field.key] = { label: source.parts[i] ?? field.accessibleLabel, symbol: field.symbol };
+    return {...base, calculations: source.answerParts};
+  }
+  if (family === 'energy') {
+    const source = energyRecord(question.ref.questionId);
+    source.fields?.forEach((field,i)=> { const part = question.parts[i]; if (part) fields[part.id] = { label:field.label, model:field.accept[0] ?? '', feedback:source.points[i] ?? source.feedback }; });
+    return {...base, feedback:source.feedback};
+  }
+  if (family === 'bonding') {
+    const source = bondingRecord(question.ref.questionId);
+    source.fields.forEach((field,i)=> { const part = question.parts[i]; if(part) fields[part.id] = {label:field.label, multiline:true, model:source.sourceAnswer, feedback:source.points[i] ?? source.feedback}; });
+    return {...base, feedback:source.feedback};
+  }
+  return base;
+}

