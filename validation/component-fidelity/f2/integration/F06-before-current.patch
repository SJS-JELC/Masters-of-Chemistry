+  width: 100%;
+  min-width: 0;
+  font:
+    700 15px/1.55 Comfortaa,
+    system-ui,
+    sans-serif;
+  color: var(--ink);
+}
+.titration-workspace * {
+  box-sizing: border-box;
+}
+.titration-workspace .kicker {
