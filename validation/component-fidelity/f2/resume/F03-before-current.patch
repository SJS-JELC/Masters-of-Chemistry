+/** Activity metadata selects presentation; question identities never select a component. */
+export const sourceFamilies: Readonly<Record<string, string>> = {
+  'alevel/acid-base-calculations': 'acid',
+  'alevel/electrons-bonding': 'bonding',
+  'alevel/electron-configurations': 'electron',
+  'alevel/ph-titration-curves': 'titration',
+  'igcse/calorimetry': 'calorimetry',
+  'igcse/bond-enthalpy': 'bond',
+  'igcse/energy-enthalpy': 'energy',
+  'igcse/energetics-practical': 'practical',
+  'igcse/structure-and-bonding': 'comparison',
+};

diff --git "a/C:\\Users\\jelc\\St John's School Leatherhead\\Chemistry - Staff Resources\\32. Masters of Chemistry\\apps\\Masters-of-Chemistry\\src\\ui\\source-presentation.ts" "b/C:\\Users\\jelc\\St John's School Leatherhead\\Chemistry - Staff Resources\\32. Masters of Chemistry\\apps\\Masters-of-Chemistry\\src\\ui\\source-presentation.ts"
new file mode 100644
index 0000000..6ada9f3
