+  font-size: 0.88rem;
+}
+.source-player .source-math-row {
+  display: contents;
+}
+.source-player .math-block {
+  display: grid;
+}
+.source-player .fraction {
+  display: inline-flex;
+  flex-direction: column;
+  vertical-align: middle;
+  text-align: center;
+}
+.source-player .fraction-top {
+  border-bottom: 1px solid currentColor;
+  padding: 0 5px;
+}
+.source-player .fraction-bottom {
+  padding: 0 5px;
+}
+.source-player .diagram svg {
+  display: block;
+  width: 100%;
+  height: auto;
+}
+.source-player .diagram img {
+  width: 100%;
+}
+.source-player .answer-options .content {
+  display: inline;
+}
+.source-player .answer-options .content p {
