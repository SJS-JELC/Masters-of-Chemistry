+/* React boundary adaptations: the accepted common shell owns page chrome. */
+.source-player {
+  min-width: 0;
+  color: #f7f7ff;
+  font-family: Comfortaa, sans-serif;
+}
+.source-player .question-header {
+  margin-bottom: 12px;
+}
+.source-player .question-workspace {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
+  gap: 22px;
+  align-items: start;
+}
+.source-player .question-content,
+.source-player .marking-pane {
+  min-width: 0;
+}
+.source-player.source-embedded .source-fields {
+  display: block;
+}
+.source-player.source-embedded .source-content {
+  padding: 0;
+  border: 0;
+  background: none;
+}
+.source-player .source-fields {
+  display: grid;
+  gap: 14px;
+}
