+  scrollbar-color: #8e9aae #edf0f5;
+}
+.ec-periodic-grid {
+  display: grid;
+  grid-template-columns: repeat(18, minmax(61px, 1fr));
+  grid-template-rows: 40px repeat(7, 70px) 22px repeat(2, 70px);
+  min-width: 1098px;
+  padding-right: 1px;
+  font-family: Arial, Helvetica, sans-serif;
+  font-weight: 400;
+  line-height: 1.1;
+}
+.ec-periodic-element,
+.ec-periodic-series,
+.ec-periodic-blank {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  border: 1px solid #535c68;
+  margin: 0 -1px -1px 0;
+  background: #fff;
+}
+.ec-periodic-number {
+  font-size: 13px;
+}
+.ec-periodic-symbol {
+  font-size: 20px;
+  font-weight: 700;
+  line-height: 1.1;
+}
+.ec-periodic-name {
+  font-size: 9px;
+  line-height: 1.3;
+  white-space: nowrap;
+}
+.ec-periodic-mass {
+  min-height: 16px;
+  font-size: 14px;
+}
+.ec-periodic-group {
+  position: absolute;
+  top: -21px;
+  left: 0;
+  width: 100%;
+  text-align: center;
+  font-size: 14px;
+  font-weight: 700;
+}
+.ec-periodic-old-group {
+  text-align: center;
+  font-size: 13px;
+  align-self: start;
+}
+.ec-periodic-key {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  justify-self: center;
+  align-self: start;
+  width: 95%;
+  padding: 9px 3px;
+  gap: 3px;
+  border: 1px solid #535c68;
+  font-size: 13px;
+}
+.ec-periodic-key strong {
+  font-size: 14px;
+  margin-bottom: 3px;
+}
+.ec-periodic-key small {
+  font-size: 10px;
+}
+.ec-periodic-series {
+  gap: 8px;
+  font-size: 13px;
+}
+.ec-periodic-series small {
+  font-size: 9px;
+}
+.ec-periodic-series-label {
+  align-self: center;
+  text-align: right;
+  padding-right: 12px;
+  font-size: 11px;
+  color: #495364;
+}
+.ec-periodic-footer {
+  display: flex;
+  justify-content: space-between;
+  gap: 16px;
+  padding: 13px 24px;
+  color: #b7c2dd;
+  font:
+    700 10px/1.6 Comfortaa,
+    system-ui,
+    sans-serif;
+  text-align: left;
+}
+@media (max-width: 600px) {
+  .ec-periodic-dialog {
+    width: calc(100% - 16px);
+    max-height: calc(100dvh - 16px);
+    border-radius: 14px;
+  }
+  .ec-periodic-heading {
+    padding: 16px;
+    gap: 12px;
+  }
+  .ec-periodic-paper {
+    padding: 14px 10px;
+  }
+  .ec-periodic-footer {
+    padding: 12px 16px;
+    flex-direction: column;
+    gap: 4px;
+  }
+  .ec-periodic-trigger {
+    padding: 8px 10px;
+  }
+  .ec-periodic-trigger-label {
+    display: none;
+  }
+}
+@media print {
+  .ec-periodic-trigger,
+  .ec-periodic-dialog {
+    display: none !important;
+  }
+}
