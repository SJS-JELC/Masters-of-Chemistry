+.ec-reference-answer .orbital {
+  width: 33px;
+  height: 39px;
+  font-size: 24px;
+}
+.ec-reference-answer .energy-level {
+  min-height: 49px;
+}
+.ec-reference-answer .energy-diagram {
+  grid-auto-rows: 12.25px;
+}
+.ec-reference-answer h3 {
+  font-size: 1rem;
+  margin: 0 0 16px;
+}
+.ec-reference-answer .answer-view h3 {
+  font-size: 0.8rem;
+  color: var(--muted);
+}
+.ec-source .ec-periodic-trigger {
+  font:
+    700 12px/1.3 Comfortaa,
+    system-ui,
+    sans-serif;
+}

