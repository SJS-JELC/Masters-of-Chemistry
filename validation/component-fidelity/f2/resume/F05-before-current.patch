+  font-size: 15px;
+  fill: #f4f6ff;
+  user-select: none;
+}
+.source-energy-profile .energy-svg [data-act] {
+  cursor: grab;
+  touch-action: none;
+}
+.source-energy-profile .energy-svg [data-act]:focus-visible {
+  outline: none;
+  filter: drop-shadow(0 0 4px #ffde59);
+  stroke: #ffde59;
+}
+.source-energy-profile .energy-svg circle[data-act] {
+  stroke: none !important;
+}
+.source-energy-profile .energy-svg circle[data-act]:focus-visible {
+  outline: 2px dashed #ffde59;
+  outline-offset: 3px;
