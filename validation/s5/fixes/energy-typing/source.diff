   | { kind: 'shaft'; name: 'ea' | 'delta' };
+
+/** Editing text is local; the profile changes only after a complete coordinate is committed. */
+function CoordinateInput({
+  label,
+  value,
+  min,
+  max,
+  disabled,
+  resetKey,
+  onCommit,
+}: {
+  readonly label: string;
+  readonly value: number;
+  readonly min: number;
+  readonly max: number;
+  readonly disabled: boolean;
+  readonly resetKey: string;
+  readonly onCommit: (value: number) => void;
+}) {
+  const [text, setText] = useState(String(value));
+  const [error, setError] = useState('');
+  const dirty = useRef(false);
+  const errorId = useId();
+  useEffect(() => {
+    setText(String(value));
+    setError('');
+    dirty.current = false;
+  }, [value, disabled, resetKey]);
+  const commit = () => {
+    if (disabled || !dirty.current) return;
+    dirty.current = false;
+    const raw = text.trim();
+    const number = Number(raw);
+    const complete = /^[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[+-]?\d+)?$/i.test(raw);
+    if (!complete || !Number.isFinite(number) || number < min || number > max) {
+      setText(String(value));
+      setError(
+        `Enter a number from ${min} to ${max}. The previous profile value (${value}) was kept.`,
+      );
+      return;
+    }
+    setText(String(number));
+    setError('');
+    if (number !== value) onCommit(number);
+  };
+  return (
+    <>
+      <input
+        aria-label={label}
+        type="text"
+        inputMode="decimal"
+        disabled={disabled}
+        value={text}
+        aria-invalid={Boolean(error)}
+        aria-describedby={error ? errorId : undefined}
+        onChange={(event) => {
+          dirty.current = true;
+          setText(event.target.value);
+          setError('');
+        }}
+        onBlur={commit}
+        onKeyDown={(event) => {
+          if (event.key === 'Enter') {
+            event.preventDefault();
+            event.stopPropagation();
+            commit();
+          }
+          if (event.key === 'Escape') {
+            event.preventDefault();
+            event.stopPropagation();
+            dirty.current = false;
+            setText(String(value));
+            setError('');
+          }
+        }}
+      />
+      {error && (
+        <span id={errorId} role="status">
+          {error}
+        </span>
+      )}
+    </>
+  );
+}
